<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>agv-system</artifactId>
    <groupId>br.usp.agv</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>infra</artifactId>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <id>agv-system-all</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/agv-system-all.jar</outputFile>
              <transformers>
                <transformer>
                  <mainClass>br.usp.agv.bootstrap.AgvSystemManager</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
          <execution>
            <id>agv-node</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/agv-node.jar</outputFile>
              <transformers>
                <transformer>
                  <mainClass>br.usp.agv.bootstrap.AgvNodeMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
          <execution>
            <id>visualizer</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/visualizer.jar</outputFile>
              <transformers>
                <transformer>
                  <mainClass>br.usp.agv.bootstrap.VisualizerMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
          <execution>
            <id>generator</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/generator.jar</outputFile>
              <transformers>
                <transformer>
                  <mainClass>br.usp.agv.bootstrap.OrderGeneratorMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
